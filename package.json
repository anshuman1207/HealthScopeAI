{
  "name": "healthscope-workspace",
  "version": "1.0.0",
  "description": "HealthScope AI - Full-Stack Healthcare Management & AI Diagnosis Platform",
  "scripts": {
    "install:all": "npm install --prefix client && npm install --prefix server-main",
