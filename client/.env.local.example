# Next.js Frontend Configuration

# Backend Service URLs (used for Next.js API rewrites / proxying)
SERVER_MAIN_URL=http://localhost:5000
SERVER_ML_URL=http://localhost:8000
SERVER_BOT_URL=http://localhost:5002

# Public API Base URLs (browser-accessible)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_BOT_API_URL=http://localhost:5002

# Optional: MongoDB URI & JWT Secret (if using internal Next.js App Router database routes)
MONGODB_URI=mongodb://localhost:27017/healthscope
JWT_SECRET=your_jwt_secret_key_change_in_production
